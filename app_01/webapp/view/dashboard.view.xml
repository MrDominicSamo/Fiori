<mvc:View
    controllerName="app01.controller.home_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Page
        id="_IDGenPage1"
        title="{i18n>title}"
    >
        <Toolbar id="_IDGenToolbar2">
            <Button
                id="_IDGenButton3"
                icon="sap-icon://menu2"
                type="Transparent"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer1" />
            <Text
                id="_IDGenText"
                text="Login Page"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer3" />
            <Button
                id="_IDGenButton4"
                text="Hi, {oUserModel>/username}"
                type="Transparent"
            />
        </Toolbar>
        
        <List id="_IDGenList1" items="{/ActivityAllocation}" >
            <StandardListItem id="_IDGenStandardListItem" type="Active" title="{FiscalYear}"></StandardListItem>
        </List>

        <footer>
            <Bar id="_IDGenBar2">
                <contentLeft>
                    <Text
                        id="_IDGenText4"
                        text="Copyright@Dominic Samo"
                    />
                </contentLeft>
                <contentRight>
                    <Text
                        id="_IDGenText5"
                        text="2026"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
