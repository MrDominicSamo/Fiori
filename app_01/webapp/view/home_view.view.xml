<mvc:View
    controllerName="app01.controller.home_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <tnt:ToolHeader id="toolHeader">
            <Button
                id="_IDGenButton"
                icon="sap-icon://menu2"
                type="Transparent"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer" />
            <Text
                id="_IDGenText1"
                text="Login Page"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer2" />
            <Button
                id="_IDGenButton1"
                text="Hi, Admin"
                type="Transparent"
            />
        </tnt:ToolHeader>
        <Text
            id="_IDGenText"
            text="Hello World"
        />
        <footer>
            <Bar id="_IDGenBar1">
                <contentLeft>
                    <Text
                        id="_IDGenText2"
                        text="Copyright@Dominic Samo"
                    />
                </contentLeft>
                <contentRight>
                    <Text
                        id="_IDGenText3"
                        text="2026"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
