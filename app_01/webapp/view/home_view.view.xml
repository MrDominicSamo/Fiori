<mvc:View
    controllerName="app01.controller.home_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Page
        id="page"
        title="{i18n>title}"
    >
        <Toolbar id="_IDGenToolbar">
            <Button
                id="_IDGenButton"
                icon="sap-icon://menu2"
                type="Transparent"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer" />
            <Text
                id="_IDGenText1"
                text="Login Page"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer2" />
            <Button
                id="_IDGenButton1"
                text="Hi, Admin"
                type="Transparent"
            />
        </Toolbar>
        <content>
            <VBox
                id="_IDGenVBox1"
                class="custform"
                fitContainer="true"
            >
                <form:SimpleForm
                    id="_IDGenSimpleForm"
                    title="Login Form"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    xmlns:form="sap.ui.layout.form"
                >
                    <Label
                        id="_IDGenLabel"
                        text="Username"
                    />
                    <Input
                        id="_username"
                        placeholder="Enter your username"
                    />
                    <Label
                        id="_IDGenLabel1"
                        text="Password"
                    />
                    <Input
                        id="_password"
                        type="Password"
                        placeholder="Enter your password"
                    />
                    <Button
                        id="_IDGenButton2"
                        text="Login"
                        type="Emphasized"
                        press="onNavigateToList()"
                    />
                </form:SimpleForm>
            </VBox>
        </content>
        <footer>
            <Bar id="_IDGenBar1">
                <contentLeft>
                    <Text
                        id="_IDGenText2"
                        text="Copyright@Dominic Samo"
                    />
                </contentLeft>
                <contentRight>
                    <Text
                        id="_IDGenText3"
                        text="2026"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
