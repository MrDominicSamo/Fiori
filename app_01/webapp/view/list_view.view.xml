<mvc:View
    controllerName="app01.controller.home_view"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
>
    <Page
        id="_IDGenPage1"
        title="{i18n>title}"
    >
        <Toolbar id="_IDGenToolbar2">
            <Button
                id="_IDGenButton3"
                icon="sap-icon://menu2"
                type="Transparent"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer1" />
            <Text
                id="_IDGenText"
                text="Data Page"
            />
            <ToolbarSpacer id="_IDGenToolbarSpacer3" />
            <Button
                id="profile_button"
                text="Hi, {oUserModel>/username}"
                type="Transparent"
                press=".profile_dropdown"
            />
        </Toolbar>

        <Table
            id="_IDGenTable1"
            items="{/ActivityAllocation}"
        >
            <columns>
                <Column id="_IDGenColumn1">
                    <Text id="_IDGenText6" text="Fiscal Year" />
                </Column>
                <Column id="_IDGenColumn2">
                    <Text id="_IDGenText7" text="Reference Document" />
                </Column>
                <Column id="_IDGenColumn3">
                    <Text id="_IDGenText8" text="Controlling Area" />
                </Column>
                <Column id="_IDGenColumn6">
                    <Text id="_IDGenText11" text="Reference Document Type" />
                </Column>
                <Column id="_IDGenColumn8">
                    <Text id="_IDGenText13" text="Accounting Document" />
                </Column>
                <Column id="_IDGenColumn4">
                    <Text id="_IDGenText9" text="Accounting Document Header Text" />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    id="_IDGenColumnListItem1"
                    type="Active"
                >
                    <cells>
                        <Text id="_IDGenText14" text="{FiscalYear}" />
                        <Text id="_IDGenText15" text="{ReferenceDocument}" />
                        <Text id="_IDGenText16" text="{ControllingArea}" />
                        <Text id="_IDGenText19" text="{ReferenceDocumentType}" />
                        <Text id="_IDGenText21" text="{AccountingDocument}" />
                        <Text id="_IDGenText10" text="{AccountingDocumentHeaderText}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <footer>
            <Bar id="_IDGenBar2">
                <contentLeft>
                    <Text
                        id="_IDGenText4"
                        text="Copyright@Dominic Samo"
                    />
                </contentLeft>
                <contentRight>
                    <Text
                        id="_IDGenText5"
                        text="2026"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
