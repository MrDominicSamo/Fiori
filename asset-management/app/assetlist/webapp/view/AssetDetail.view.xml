<mvc:View
    controllerName="assetlist.controller.AssetDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
>
    <Page
        id="_IDGenPage"
        title="Asset Details"
        showNavButton="true"
        navButtonPress=".onNavBack"
    >
        <content>
            <uxap:ObjectPageLayout
                id="_IDGenObjectPageLayout1"
                showFooter="true"
                enableLazyLoading="true"
            >
                <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle
                        id="_IDGenObjectPageDynamicHeaderTitle"
                    >
                        <uxap:heading>
                            <VBox id="_IDGenVBox">
                                <Title
                                    id="_IDGenTitle1"
                                    text="{name}"
                                    level="H2"
                                />

                                <ObjectIdentifier
                                    id="_IDGenObjectIdentifier"
                                    title="{ID}"
                                />
                            </VBox>
                        </uxap:heading>

                        <uxap:expandedHeading>
                            <VBox id="_IDGenVBox1">
                                <Title
                                    id="_IDGenTitle2"
                                    text="{name}"
                                    level="H1"
                                />

                                <ObjectIdentifier
                                    id="_IDGenObjectIdentifier1"
                                    title="{ID}"
                                />
                            </VBox>
                        </uxap:expandedHeading>

                        <uxap:snappedHeading>
                            <Title
                                id="_IDGenTitle3"
                                text="{name}"
                            />
                        </uxap:snappedHeading>

                        <uxap:actions>
                            <Button
                                id="_IDGenButton"
                                text="{i18n>edit}"
                                icon="sap-icon://edit"
                                type="Emphasized"
                                press=".onEditPress"
                            />

                            <Button
                                id="_IDGenButton2"
                                text="{i18n>delete}"
                                icon="sap-icon://delete"
                                type="Negative"
                                press=".onDeletePress"
                            />
                        </uxap:actions>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle>

                <uxap:headerContent>
                    <ObjectStatus
                        id="_IDGenObjectStatus"
                        text="{status}"
                        state="{=
                    ${status} === 'Available'
                    ? 'Success'
                    : ${status} === 'Assigned'
                    ? 'Warning'
                    : 'Error'
                }"
                    />
                </uxap:headerContent>

                <uxap:sections>
                    <uxap:ObjectPageSection
                        id="_IDGenObjectPageSection"
                        title="General Information"
                    >
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection
                                id="_IDGenObjectPageSubSection"
                            >
                                <uxap:blocks>
                                    <form:SimpleForm
                                        id="_IDGenSimpleForm"
                                        editable="false"
                                        layout="ResponsiveGridLayout"
                                        columnsXL="2"
                                        columnsL="2"
                                        columnsM="1"
                                    >
                                        <Label
                                            id="_IDGenLabel"
                                            text="Asset ID"
                                        />
                                        <Text
                                            id="_IDGenText8"
                                            text="{ID}"
                                        />

                                        <Label
                                            id="_IDGenLabel1"
                                            text="Name"
                                        />
                                        <Text
                                            id="_IDGenText9"
                                            text="{name}"
                                        />

                                        <Label
                                            id="_IDGenLabel2"
                                            text="Category"
                                        />
                                        <Text
                                            id="_IDGenText10"
                                            text="{category}"
                                        />

                                        <Label
                                            id="_IDGenLabel3"
                                            text="Location"
                                        />
                                        <Text
                                            id="_IDGenText11"
                                            text="{location}"
                                        />

                                        <Label
                                            id="_IDGenLabel4"
                                            text="Status"
                                        />

                                        <ObjectStatus
                                            id="_IDGenObjectStatus1"
                                            text="{status}"
                                            state="{=
                                        ${status} === 'Available'
                                        ? 'Success'
                                        : ${status} === 'Assigned'
                                        ? 'Warning'
                                        : 'Error'
                                    }"
                                        />

                                        <Label
                                            id="_IDGenLabel5"
                                            text="Assigned To"
                                        />

                                        <Text
                                            id="_IDGenText12"
                                            text="{=
                                        ${assignedTo}
                                        ? ${assignedTo}
                                        : 'Not Assigned'
                                    }"
                                        />
                                    </form:SimpleForm>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>
                </uxap:sections>
            </uxap:ObjectPageLayout>
        </content>
    </Page>
</mvc:View>
